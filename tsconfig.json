{
    "compilerOptions": {
        "module": "commonjs",
        "removeComments": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "target": "ES2015",
        "strict": true,
        "rootDir": ".",
        "outDir": "dist",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "include": [
        "./**/*.ts"
    ],
    "exclude": [
        "__tests__/**/*",
        "node_modules/**/*",
        "dist",
        "dist-dev",
        "dist-prod"
    ],
    "paths": {
        "@shapediver/viewer.shared.node-tree": "./shared/node-tree/src/index.ts",
        "@shapediver/viewer": "./api/api/src/index.ts",
    }
}