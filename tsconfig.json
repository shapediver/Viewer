{
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"composite": true,
		"module": "commonjs",
		"removeComments": false,
		"esModuleInterop": true,
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"target": "ES6",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"outDir": "dist",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"moduleResolution": "node",
		"skipLibCheck": true
	},
	"include": ["./**/*.ts"],
	"exclude": [
		"__tests__",
		"../../node_modules",
		"node_modules",
		"dist",
		"dist-dev"
	],
	"paths": {
		"@shapediver/viewer": "./api/default/src/index.ts"
	}
}
