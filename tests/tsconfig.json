{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"lib": ["ES2020", "DOM"],
		"strict": false,
		"esModuleInterop": true,
		"moduleResolution": "node",
		"ignoreDeprecations": "6.0",
		"resolveJsonModule": true,
		"outDir": "dist"
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
