{
  "name": "root",
  "private": true,
  "devDependencies": {
    "@types/jest": "^26.0.15",
    "@types/jest-image-snapshot": "^4.3.0",
    "@types/node": "^14.14.9",
    "@types/puppeteer": "^5.4.3",
    "aws-sdk": "^2.771.0",
    "chromium": "^3.0.2",
    "gl-matrix": "^3.3.0",
    "jest": "^26.6.3",
    "jest-cli": "^26.6.3",
    "jest-image-snapshot": "^4.4.0",
    "jest-puppeteer": "^4.4.0",
    "json": "^10.0.0",
    "lerna": "^3.22.1",
    "puppeteer": "^7.1.0",
    "recursive-readdir-sync": "^1.0.6",
    "ts-jest": "^26.4.4",
    "ts-loader": "^8.0.11",
    "ts-node": "^9.0.0",
    "tsyringe": "^4.4.0",
    "typedoc": "^0.20.33",
    "typescript": "^4.1.2",
    "webpack": "^5.6.0",
    "webpack-cli": "^4.2.0",
    "webpack-dev-server": "^3.11.0",
    "webpack-merge": "^5.4.0"
  },
  "scripts": {
    "bootstrap": "npm run check-npm-version && lerna bootstrap --hoist",
    "clean": "lerna clean --yes",
    "check-npm-version": "bash ./scripts/check-npm-version.sh",
    "create-lib": "npm run check-npm-version && bash ./scripts/create-lib.sh",
    "create-package": "bash ./scripts/create-package.sh",
    "doc": "rm -rf ./docs && typedoc && cp -r api/api/images docs/images",
    "add-dependency": "bash ./scripts/add-dependency.sh",
    "add-devDependency": "bash ./scripts/add-devDependency.sh",
    "publish": "lerna publish --no-private --force-publish --no-push --registry https://npm.pkg.github.com/",
    "init": "bash ./scripts/init.sh",
    "test": "lerna run test",
    "build": "lerna run build",
    "build-dep": "lerna run build-dep",
    "build-current": "cd ./api/api && npm run build-dep && cd ../../",
    "deploy": "ts-node ./scripts/deploy.ts"
  }
}
