{
  "name": "root",
  "private": true,
  "devDependencies": {
    "@shapediver/sdk.platform-api": "^1.14.0",
    "@types/chromedriver": "^81.0.1",
    "@types/jest": "^26.0.15",
    "@types/jest-image-snapshot": "^4.3.0",
    "@types/node": "^15.12.4",
    "@types/pako": "^1.0.2",
    "@types/puppeteer": "^5.4.3",
    "@types/selenium-webdriver": "^4.0.14",
    "aws-sdk": "^2.932.0",
    "chargebee-typescript": "^2.0.8",
    "chromedriver": "^98.0.0",
    "chromium": "^3.0.2",
    "http-server": "^0.12.3",
    "jest": "^26.6.3",
    "jest-cli": "^26.6.3",
    "jest-image-snapshot": "^4.5.0",
    "jest-puppeteer": "^5.0.4",
    "json": "^11.0.0",
    "lerna": "3.22.1",
    "pako": "^2.0.3",
    "prompt": "^1.1.0",
    "puppeteer": "^9.0.0",
    "recursive-readdir-sync": "^1.0.6",
    "selenium-webdriver": "^4.0.0-beta.4",
    "start-server-and-test": "^1.12.5",
    "ts-jest": "^26.4.4",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "typedoc": "^0.21.9",
    "typescript": "^4.3.4",
    "webpack": "^5.40.0",
    "webpack-cli": "^4.7.2",
    "webpack-dev-server": "^3.11.0",
    "webpack-merge": "^5.8.0"
  },
  "scripts": {
    "bootstrap": "npm run check-npm-version && lerna bootstrap --hoist --force-local",
    "clean": "lerna clean --yes && rm -rf node_modules",
    "check-npm-version": "bash ./scripts/check-npm-version.sh",
    "create-lib": "npm run check-npm-version && bash ./scripts/create-lib.sh",
    "create-package": "bash ./scripts/create-package.sh",
    "doc": "ts-node ./scripts/doc.ts",
    "add-dependency": "bash ./scripts/add-dependency.sh",
    "add-devDependency": "bash ./scripts/add-devDependency.sh",
    "init": "bash ./scripts/init.sh",
    "test": "lerna run test --stream --concurrency 1 --no-bail",
    "test-browserstack": "lerna run --no-bail test-browserstack --stream --concurrency 1",
    "build": "lerna run build --stream",
    "build-watch": "lerna run build-watch --stream --parallel",
    "build-dep": "lerna run build-dep",
    "build-prod": "lerna run build-prod --stream",
    "build-current": "cd ./api/api && npm run build-dep && cd ../../",
    "deploy": "ts-node ./scripts/deploy.ts",
    "deploy-no-tests": "ts-node ./scripts/deploy-no-tests.ts",
    "deploy-example": "ts-node ./scripts/deploy-example.ts",
    "deploy-tests": "ts-node ./scripts/deploy-tests.ts",
    "deploy-test": "ts-node ./scripts/deploy-test.ts",
    "deploy-and-test": "npm run deploy-tests && npm run test",
    "deploy-demo": "ts-node ./scripts/deploy-demo.ts",
    "platform-api-token": "ts-node ./tests/general/src/utils.ts",
    "doc-releaseNotes": "typedoc --readme documentation/releaseNotes.md",
    "doc-breakingChangesGuide": "typedoc --readme documentation/breakingChangesGuide.md",
    "doc-main": "typedoc"
  }
}
