{
	"name": "root",
	"private": true,
	"devDependencies": {
		"@aws-sdk/client-s3": "3.421.0",
		"@types/chromedriver": "81.0.1",
		"@types/jest": "27.5.2",
		"@types/jest-image-snapshot": "4.3.2",
		"@types/node": "17.0.45",
		"@types/pako": "1.0.4",
		"@types/puppeteer": "5.4.7",
		"@types/selenium-webdriver": "4.1.11",
		"@typescript-eslint/eslint-plugin": "5.57.0",
		"@typescript-eslint/parser": "5.57.0",
		"chargebee-typescript": "2.17.0",
		"chromedriver": "147.0.3",
		"chromium": "3.0.3",
		"dotenv": "17.3.1",
		"eslint": "8.37.0",
		"eslint-config-prettier": "10.1.1",
		"eslint-plugin-prettier": "5.2.4",
		"http-server": "14.1.1",
		"jest": "27.5.1",
		"jest-cli": "27.5.1",
		"jest-image-snapshot": "4.5.1",
		"jest-puppeteer": "6.2.0",
		"json": "11.0.0",
		"lerna": "4.0.0",
		"node-fetch": "3.3.0",
		"pako": "2.1.0",
		"path-browserify": "1.0.1",
		"prettier": "3.5.3",
		"prettier-plugin-organize-imports": "4.1.0",
		"puppeteer": "13.7.0",
		"recursive-readdir-sync": "1.0.6",
		"selenium-webdriver": "4.8.1",
		"source-map-loader": "5.0.0",
		"start-server-and-test": "1.15.4",
		"terser-webpack-plugin": "5.3.16",
		"ts-jest": "27.1.5",
		"ts-loader": "8.4.0",
		"ts-node": "10.9.1",
		"typedoc": "0.22.18",
		"typescript": "4.7.3",
		"webpack": "5.94.0",
		"webpack-bundle-analyzer": "4.10.2",
		"webpack-cli": "4.10.0",
		"webpack-dev-server": "4.11.1",
		"webpack-merge": "5.8.0",
		"webpack-node-externals": "3.0.0"
	},
	"scripts": {
		"bootstrap": "lerna bootstrap --hoist --force-local",
		"clean": "lerna clean --yes",
		"hard-reset": "lerna exec -- rm -rf ./dist && lerna exec -- rm -rf package-lock.json && lerna exec -- rm -rf tsconfig.tsbuildinfo && npm run clean",
		"init": "bash ./scripts/other/init.sh",
		"init-build": "npm run init && npm run build",
		"test": "lerna run test --stream --no-bail --concurrency 3",
		"test-samples-only": "lerna run test-sample --stream --no-bail",
		"check": "lerna run check",
		"build": "lerna run build-all --stream",
		"build-watch": "lerna run build-watch --stream --parallel",
		"build-tests": "lerna run build-test --stream",
		"build-examples": "lerna run build-example --stream",
		"publish-viewer": "ts-node ./scripts/publishing/publish-viewer.ts",
		"deploy-doc-version": "ts-node ./scripts/deploying/deploy-doc-version.ts",
		"deploy-example": "ts-node ./scripts/deploying/deploy-example.ts",
		"deploy-tests": "ts-node ./scripts/deploying/deploy-tests.ts",
		"deploy-and-test": "ts-node ./scripts/testing/deploy-and-test.ts",
		"deploy-and-test-samples-only": "ts-node ./scripts/testing/deploy-and-test-samples-only.ts",
		"doc": "rm -rf ./docs && ts-node ./scripts/other/doc.ts && npm run llms && cp ./llms.txt ./docs/",
		"llms": "node ./scripts/other/generate-llms.js",
		"set-github-registry": "npm config set @shapediver:registry https://npm.pkg.github.com --location=project",
		"set-npm-registry": "npm config set @shapediver:registry https://registry.npmjs.org/ --location=project",
		"lerna-publish-github": "npm run set-github-registry && lerna publish from-package --yes --no-private --force-publish",
		"lerna-publish-npm": "npm run set-npm-registry && lerna publish from-package --yes --no-private --force-publish && npm run set-github-registry",
		"prettier": "prettier --write \"**/*.{ts,js,json,md}\""
	}
}
