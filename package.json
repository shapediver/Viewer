{
  "name": "root",
  "private": true,
  "devDependencies": {
    "@types/chromedriver": "^81.0.0",
    "@types/jest": "^26.0.15",
    "@types/jest-image-snapshot": "^4.3.0",
    "@types/node": "^14.14.9",
    "@types/puppeteer": "^5.4.3",
    "@types/selenium-webdriver": "^4.0.12",
    "aws-sdk": "^2.883.0",
    "chromedriver": "^90.0.0",
    "chromium": "^3.0.2",
    "http-server": "^0.12.3",
    "jest": "^26.6.3",
    "jest-cli": "^26.6.3",
    "jest-image-snapshot": "^4.4.1",
    "jest-puppeteer": "^5.0.4",
    "json": "^10.0.0",
    "lerna": "^4.0.0",
    "pako": "^2.0.3",
    "prompt": "^1.1.0",
    "puppeteer": "^8.0.0",
    "recursive-readdir-sync": "^1.0.6",
    "selenium-webdriver": "^4.0.0-beta.3",
    "start-server-and-test": "^1.12.1",
    "ts-jest": "^26.4.4",
    "ts-loader": "^8.0.11",
    "ts-node": "^9.0.0",
    "typedoc": "^0.20.35",
    "typescript": "^4.2.4",
    "webpack": "^5.31.0",
    "webpack-cli": "^4.2.0",
    "webpack-dev-server": "^3.11.0",
    "webpack-merge": "^5.4.0"
  },
  "scripts": {
    "bootstrap": "npm run check-npm-version && lerna bootstrap --hoist",
    "clean": "lerna clean --yes && rm -rf node_modules",
    "check-npm-version": "bash ./scripts/check-npm-version.sh",
    "create-lib": "npm run check-npm-version && bash ./scripts/create-lib.sh",
    "create-package": "bash ./scripts/create-package.sh",
    "doc": "ts-node ./scripts/doc.ts",
    "add-dependency": "bash ./scripts/add-dependency.sh",
    "add-devDependency": "bash ./scripts/add-devDependency.sh",
    "init": "bash ./scripts/init.sh",
    "test": "lerna run test --stream --concurrency 1",
    "test-browserstack": "lerna run test-browserstack --stream --concurrency 1",
    "build": "lerna run build --stream",
    "build-watch": "lerna run build-watch --stream --parallel",
    "build-dep": "lerna run build-dep",
    "build-prod": "lerna run build-prod --stream",
    "build-current": "cd ./api/api && npm run build-dep && cd ../../",
    "deploy": "ts-node ./scripts/deploy.ts",
    "deploy-tests": "ts-node ./scripts/deploy-test.ts",
    "doc-releaseNotes": "typedoc --readme documentation/releaseNotes.md",
    "doc-migrationGuide": "typedoc --readme documentation/migrationGuide.md",
    "doc-main": "typedoc"
  }
}
