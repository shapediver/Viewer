{
  "name": "root",
  "private": true,
  "devDependencies": {
    "@types/chromedriver": "^81.0.1",
    "@types/jest": "^27.4.1",
    "@types/jest-image-snapshot": "^4.3.1",
    "@types/node": "^17.0.27",
    "@types/pako": "^1.0.3",
    "@types/puppeteer": "^5.4.5",
    "@types/selenium-webdriver": "^4.0.19",
    "aws-sdk": "^2.1121.0",
    "chargebee-typescript": "^2.8.0",
    "chromedriver": "^103.0.0",
    "chromium": "^3.0.3",
    "http-server": "^14.1.0",
    "jest": "^27.5.1",
    "jest-cli": "^27.5.1",
    "jest-image-snapshot": "^4.5.1",
    "jest-puppeteer": "^6.1.0",
    "json": "^11.0.0",
    "lerna": "^4.0.0",
    "node-fetch": "^3.2.3",
    "pako": "^2.0.4",
    "path-browserify": "^1.0.1",
    "puppeteer": "^13.6.0",
    "recursive-readdir-sync": "^1.0.6",
    "selenium-webdriver": "^4.1.1",
    "start-server-and-test": "^1.14.0",
    "terser-webpack-plugin": "^5.3.3",
    "ts-jest": "^27.1.4",
    "ts-loader": "^8.4.0",
    "ts-node": "^10.7.0",
    "typedoc": "^0.22.15",
    "typescript": "4.4.4",
    "webpack": "^5.72.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.8.1",
    "webpack-merge": "^5.8.0"
  },
  "scripts": {
    "bootstrap": "lerna bootstrap --hoist --force-local",
    "clean": "lerna clean --yes && rm -rf node_modules",
    "doc": "ts-node ./scripts/doc.ts",
    "init": "bash ./scripts/init.sh",
    "test": "lerna run test --concurrency 1 --stream --no-bail",
    "test-all": "lerna run test --concurrency 4 --stream --no-bail && npm run test-browserstack",
    "test-browserstack": "lerna run test-browserstack --stream --no-bail ",
    "build": "lerna run build --stream",
    "build-watch": "lerna run build-watch --stream --parallel",
    "build-dep": "lerna run build-dep",
    "build-prod": "lerna run build-prod --stream",
    "build-current": "lerna run build-current --stream",
    "deploy": "ts-node ./scripts/deploy.ts",
    "deploy-no-tests": "ts-node ./scripts/deploy-no-tests.ts",
    "deploy-example": "ts-node ./scripts/deploy-example.ts",
    "deploy-tests": "ts-node ./scripts/deploy-tests.ts",
    "deploy-test": "ts-node ./scripts/deploy-test.ts",
    "deploy-and-test": "npm run deploy-tests && npm run test",
    "deploy-demo": "ts-node ./scripts/deploy-demo.ts",
    "doc-releaseNotes": "typedoc --readme documentation/releaseNotes.md",
    "doc-breakingChangesGuide": "typedoc --readme documentation/breakingChangesGuide.md",
    "doc-main": "typedoc"
  }
}
