{
	"name": "root",
	"private": true,
	"devDependencies": {
		"@aws-sdk/client-s3": "3.1053.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.60.0",
		"@types/node": "25.9.1",
		"@types/pako": "2.0.4",
		"@typescript-eslint/eslint-plugin": "8.60.0",
		"@typescript-eslint/parser": "8.60.0",
		"axios": "1.16.1",
		"dotenv": "17.4.2",
		"eslint": "10.4.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.5",
		"lerna": "9.0.7",
		"pako": "2.1.0",
		"prettier": "3.8.3",
		"prettier-plugin-organize-imports": "4.3.0",
		"puppeteer": "25.1.0",
		"recursive-readdir-sync": "1.0.6",
		"ts-node": "10.9.2",
		"typedoc": "0.28.19",
		"typescript": "6.0.3",
		"vite": "8.0.14"
	},
	"scripts": {
		"clean": "lerna exec -- rm -rf ./node_modules && rm -rf ./node_modules",
		"hard-reset": "lerna exec -- rm -rf ./dist && lerna exec -- rm -rf tsconfig.tsbuildinfo && npm run clean",
		"test": "playwright test --config tests/playwright.config.ts",
		"test-ui": "playwright test --config tests/playwright.config.ts --ui",
		"test-update": "playwright test --config tests/playwright.config.ts --update-snapshots",
		"test-install": "cd tests && npx playwright install chromium",
		"check": "lerna run check",
		"build": "lerna run build --stream --scope=@shapediver/viewer --include-dependencies && lerna run build-all --stream --ignore=@shapediver/viewer",
		"build-watch": "lerna run build-watch --stream --parallel",
		"build-tests": "lerna run build-test --stream",
		"build-examples": "lerna run build-example --stream",
		"publish-viewer": "ts-node -T ./scripts/publishing/publish-viewer.ts",
		"deploy-example": "ts-node -T ./scripts/deploying/deploy-example.ts",
		"deploy-tests": "ts-node -T ./scripts/deploying/deploy-tests.ts",
		"deploy-and-test": "ts-node -T ./scripts/testing/deploy-and-test.ts",
		"deploy-and-test-samples-only": "ts-node -T ./scripts/testing/deploy-and-test-samples-only.ts",
		"doc": "rm -rf ./docs && ts-node -T ./scripts/other/doc.ts && npm run llms && cp ./llms.txt ./docs/",
		"llms": "node ./scripts/other/generate-llms.js",
		"set-github-registry": "pnpm config set @shapediver:registry https://npm.pkg.github.com --location=project",
		"set-npm-registry": "pnpm config set @shapediver:registry https://registry.npmjs.org/ --location=project",
		"lerna-publish-github": "npm run set-github-registry && lerna publish from-package --yes --no-private --force-publish",
		"lerna-publish-npm": "npm run set-npm-registry && lerna publish from-package --yes --no-private --force-publish && npm run set-github-registry",
		"prettier": "prettier --write \"**/*.{ts,js,json,md}\""
	}
}
