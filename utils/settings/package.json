{
	"name": "@shapediver/viewer.settings",
	"version": "1.2.5",
	"description": "",
	"keywords": [],
	"author": "Michael Oppitz <michael@shapediver.com>",
	"license": "polyform-noncommercial-1.0.0",
	"main": "dist/index.js",
	"directories": {
		"test": "__tests__"
	},
	"files": [
		"package.json",
		"dist/",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shapediver/Viewer.git"
	},
	"scripts": {
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js __tests__",
		"check": "tsc --noEmit",
		"build": "bash ../../scripts/building/build.sh",
		"build-watch": "bash ../../scripts/building/build-watch.sh",
		"build-dep": "bash ../../scripts/building/build-dep.sh",
		"build-all": "npm run build"
	},
	"bugs": {
		"url": "https://github.com/shapediver/Viewer/issues"
	},
	"homepage": "https://github.com/shapediver/Viewer#readme",
	"typings": "dist/index.d.ts",
	"jest": {
		"preset": "ts-jest",
		"testEnvironment": "node",
		"extensionsToTreatAsEsm": [
			".ts"
		],
		"transform": {
			"^.+\\.tsx?$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.test.json",
					"useESM": true
				}
			]
		}
	},
	"devDependencies": {
		"@types/jest": "30.0.0",
		"gl-matrix": "3.4.4",
		"jest": "30.4.2",
		"jest-cli": "30.4.2",
		"ts-jest": "29.4.11",
		"typescript": "6.0.3"
	},
	"dependencies": {
		"zod": "4.4.3",
		"uuid": "14.0.0"
	}
}
